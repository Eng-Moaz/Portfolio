---
import {getEntry} from 'astro:content';
import {preview} from '@/lib/content';
import MediaAsset from './MediaAsset.astro';
interface Props {group:string;}
const {group}=Astro.props;
const about=await getEntry('pages','about');
const photos=about?.data.media.filter(m=>m.group===group&&(preview||!m.sample))??[];
const slots=about?.data.photoSlots.filter(s=>s.group===group)??[];
---
{(photos.length>0||slots.length>0)&&<div class:list={['snapshots',`snapshots--${group}`]}>{photos.map(p=><figure><MediaAsset src={p.src} image={p.image} alt={p.alt} width={p.width} height={p.height}/>{p.caption&&<figcaption>{p.caption}</figcaption>}</figure>)}{slots.map(s=><figure class="photo-placeholder"><div aria-hidden="true"><span>照片</span><small>a photograph, soon</small></div><figcaption>Photo placeholder · {s.caption}</figcaption></figure>)}</div>}
