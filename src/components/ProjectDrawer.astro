---
import type { CollectionEntry } from 'astro:content';
import MediaGallery from './MediaGallery.astro';
interface Props { projects:CollectionEntry<'projects'>[] }
const {projects}=Astro.props;
---
<section class="work-section" id="work" aria-labelledby="work-title">
<div class="section-heading-row"><h2 id="work-title">Things I've been building<span class="dot">.</span></h2><a class="handwriting" href="/work/">the whole drawer ↗</a></div>
<div class="project-drawer" data-project-drawer>
<div class="project-tabs" role="tablist" aria-label="Selected projects" aria-orientation="vertical">
{projects.map((p,i)=><button type="button" role="tab" id={`project-tab-${i}`} aria-controls={`project-panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-project-tab data-href={`/work/${p.id}/`}><span>{p.data.title}</span><small>{p.data.language}</small><span class="tab-arrow" aria-hidden="true">↗</span></button>)}
</div>
<div class="project-panels">{projects.map((p,i)=><article class="project-panel" role="tabpanel" id={`project-panel-${i}`} aria-labelledby={`project-tab-${i}`} hidden={i!==0} data-project-panel><MediaGallery media={p.data.media} compact/><div class="project-copy"><p class="handwriting">{p.data.note}</p><h3>{p.data.title}</h3><p>{p.data.summary}</p><a class="project-link" href={`/work/${p.id}/`}>Open project →</a></div></article>)}</div>
</div></section>
<script>
document.querySelectorAll<HTMLElement>('[data-project-drawer]').forEach(drawer=>{
 const tabs=Array.from(drawer.querySelectorAll<HTMLButtonElement>('[data-project-tab]'));
 const panels=Array.from(drawer.querySelectorAll<HTMLElement>('[data-project-panel]'));
 const select=(i:number,focus=false)=>{tabs.forEach((t,n)=>{t.setAttribute('aria-selected',String(i===n));t.tabIndex=i===n?0:-1;panels[n].hidden=i!==n;});if(focus)tabs[i].focus();};
 tabs.forEach((t,i)=>{t.addEventListener('focus',()=>select(i));t.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse' && !drawer.contains(document.activeElement))select(i);});t.addEventListener('click',e=>{select(i);if((e as PointerEvent).pointerType==='mouse' && matchMedia('(min-width:801px) and (hover:hover)').matches)location.href=t.dataset.href!;});t.addEventListener('keydown',e=>{if(!['ArrowDown','ArrowUp','Home','End'].includes(e.key))return;e.preventDefault();select(e.key==='Home'?0:e.key==='End'?tabs.length-1:(i+(e.key==='ArrowDown'?1:-1)+tabs.length)%tabs.length,true);});});
});
</script>