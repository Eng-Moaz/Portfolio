---
import cache from '@/data/github.json';
import {preview} from '@/lib/content';
const real=cache.days.length>0;
const days=real?cache.days:Array.from({length:364},(_,i)=>({date:new Date(Date.UTC(2025,8,21+i)).toISOString().slice(0,10),count:(i*17%13)<5?i%7:0,level:(i*17%13)<5?i%4+1:0}));
const offset=new Date(days[0].date+'T00:00:00Z').getUTCDay();
const weeks=Math.ceil((days.length+offset)/7);
const months=days.filter(d=>d.date.endsWith('-01'));
---
<section class="contributions" aria-labelledby="activity-title"><div class="section-heading-row"><div><h2 id="activity-title">Little by little.</h2><p>{real?`${days.reduce((s,d)=>s+d.count,0).toLocaleString()} GitHub contributions in the displayed period`:'Preview data — GitHub connection pending'}</p></div><a class="activity-link" href="https://github.com/Eng-Moaz">GitHub <svg viewBox="0 0 30 24" width="30" height="24" aria-hidden="true"><path d="M3 19C12 19 18 12 25 5M15 5l11-1-1 11"/></svg></a></div>
{(real||preview)&&<><div class="calendar-scroll" tabindex="0" role="region" aria-label="GitHub contribution calendar; scroll horizontally on small screens"><div class="calendar-months" style={`--weeks:${weeks}`}>{months.map(d=><span style={`grid-column:${Math.floor((days.indexOf(d)+offset)/7)+1}`}>{new Date(d.date+'T00:00:00Z').toLocaleDateString('en',{month:'short',timeZone:'UTC'})}</span>)}</div><div class="calendar" style={`--weeks:${weeks}`}>{Array.from({length:offset},()=> <span/>)}{days.map(d=><span class={`day level-${d.level}`} role="img" aria-label={`${d.count} contributions on ${d.date}`} title={`${d.date}: ${d.count} contributions`}/>)}</div></div><div class="calendar-caption"><span>{days[0].date} — {days.at(-1)?.date} {real&&`· fetched ${cache.fetchedAt.slice(0,10)}`}</span><span class="legend">Less {[0,1,2,3,4].map(n=><i class={`day level-${n}`}/>)} More</span></div><details class="activity-details"><summary>Accessible daily counts</summary><div class="daily-counts">{days.map(d=><p>{d.date}: {d.count} contributions</p>)}</div></details></>}
</section>
