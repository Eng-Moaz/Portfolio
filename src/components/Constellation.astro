<div class="constellation" aria-hidden="true">
  <svg viewBox="0 0 400 310"><path d="M48 162C4 42 327 10 357 140S101 294 48 162Z"/><path d="M99 41C211-8 349 246 253 276S36 97 99 41Z"/></svg>
  <span class="sticker docker"><img src="/images/logos/docker.svg" alt="" width="70" height="58"/></span>
  <span class="sticker torch"><img src="/images/logos/pytorch.svg" alt="" width="52" height="62"/></span>
  <span class="sticker go"><img src="/images/logos/go.svg" alt="" width="78" height="48"/></span>
  <span class="sticker kube"><img src="/images/logos/kubernetes.svg" alt="" width="58" height="58"/></span>
  <span class="sticker aws"><img src="/images/logos/aws.svg" alt="" width="46" height="34"/></span>
  <span class="sticker terraform"><img src="/images/logos/terraform.svg" alt="" width="32" height="36"/></span>
  <span class="orbit-note handwriting">a few things in my orbit</span>
</div>
<script>
const constellation=document.querySelector<HTMLElement>('.constellation');
if(constellation){const observer=new IntersectionObserver(([entry])=>{constellation.classList.toggle('orbit-paused',!entry.isIntersecting);});observer.observe(constellation);}
</script>
