---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
interface Props {src?:string;image?:ImageMetadata;alt:string;width:number;height:number;eager?:boolean;}
const {src,image,alt,width,height,eager=false}=Astro.props;
---
{image ? <Image src={image} alt={alt} widths={[480,800,1200]} sizes="(max-width: 800px) 100vw, 700px" loading={eager?'eager':'lazy'} decoding="async"/> : <img src={src} alt={alt} width={width} height={height} loading={eager?'eager':'lazy'} decoding="async"/>}
