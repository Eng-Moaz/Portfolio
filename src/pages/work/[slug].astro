---
import {render} from 'astro:content';
import ProjectArticleLayout from '@/layouts/ProjectArticleLayout.astro';
import MediaGallery from '@/components/MediaGallery.astro';
import {entries} from '@/lib/content';
export async function getStaticPaths(){return (await entries('projects')).map(p=>({params:{slug:p.id},props:{project:p}}));}
const {project:p}=Astro.props; const {Content,headings}=await render(p);
---
<ProjectArticleLayout project={p} headings={headings}>
{!p.data.caseStudy&&<><p class="handwriting">{p.data.note}</p><ul>{p.data.facts.map(f=><li>{f}</li>)}</ul></>}
<Content/>
{!p.data.caseStudy&&<MediaGallery media={p.data.media}/>}
</ProjectArticleLayout>
