---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import ThemeToggle from '@/components/ThemeToggle.astro';
import {preview} from '@/lib/content';
import {cvPath} from '@/lib/site';
import Icon from '@/components/Icon.astro';
import {existsSync,statSync} from 'node:fs';
import {resolve} from 'node:path';
const cvFile=resolve('public',cvPath.slice(1));
const hasCV=existsSync(cvFile)&&statSync(cvFile).isFile();

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Moaz Mohamed',
  description = 'Field notes on software, machine learning, and the infrastructure behind them.',
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const noindex = preview || import.meta.env.VERCEL_ENV === 'preview';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F4EB" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical}/>}
    {noindex && <meta name="robots" content="noindex, nofollow"/>}
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Moaz Mohamed"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    {canonical && <meta property="og:url" content={canonical}/>}
    <meta name="twitter:card" content="summary"/>
    <script is:inline>
      let savedTheme; try { savedTheme = localStorage.getItem('engineering-notebook-theme'); } catch {}
      const preferredTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = savedTheme || preferredTheme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="page-tools">{hasCV ? <a class="cv-link icon-link" href={cvPath} download><Icon name="download"/>Download CV</a> : import.meta.env.DEV && <span class="cv-link cv-link--disabled" aria-disabled="true" title={`Add ${cvPath} to enable this download`}><Icon name="download"/>CV coming soon</span>}<ThemeToggle /></div>
    {preview && <div class="preview-banner">Local preview · includes unpublished samples</div>}
    <slot />
    <script is:inline>
      for (const link of document.querySelectorAll('a[href]')) {
        const href = link.getAttribute('href');
        if (!href) continue;
        const destination = new URL(href, location.href);
        if ((destination.protocol === 'http:' || destination.protocol === 'https:') && destination.origin !== location.origin) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
      }
    </script>
  </body>
</html>
